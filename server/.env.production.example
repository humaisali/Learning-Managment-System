# ═══════════════════════════════════════════════════
# LMS Platform — Production Environment Configuration
# ═══════════════════════════════════════════════════
# 
# REQUIRED: All variables without defaults MUST be set.
# Copy to .env and fill in real values before deploying.
# 
# NEVER commit this file with real secrets to version control.
# ═══════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────
NODE_ENV=production
PORT=5000
CLIENT_URL=https://yourdomain.com

# ─── Database (REQUIRED) ─────────────────────────
# Use a managed PostgreSQL instance (AWS RDS, Supabase, DO Managed DB)
DATABASE_URL="mongodb://username:password@your-db-host:27017/lms_platform?replicaSet=rs0&authSource=admin"

# ─── Redis (REQUIRED for production) ─────────────
REDIS_URL=redis://host:6379

# ─── JWT Secrets (REQUIRED — generate with: openssl rand -hex 32) ───
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OTP Settings ────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ─── Safepay (REQUIRED for payments) ─────────────
# Get credentials from https://dashboard.safepay.com
SAFEPAY_API_KEY=
SAFEPAY_SECRET=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_SANDBOX=false

# ─── Bunny Stream (REQUIRED for video) ───────────
# Get credentials from https://panel.bunny.net
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=

# ─── Mux Live (REQUIRED for live sessions) ───────
# Get credentials from https://dashboard.mux.com
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ─── Email — Resend (REQUIRED) ──────────────────
# Get API key from https://resend.com
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ─── SMS Provider ────────────────────────────────
# Options: mock (dev), twilio, local
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_SENDER_ID=LMS
