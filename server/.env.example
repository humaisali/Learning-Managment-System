# ─── Server ──────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── Database ────────────────────────────────────
DATABASE_URL="mongodb://localhost:27017/lms_platform?replicaSet=rs0"

# ─── Redis ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long-replace-this
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long-replace-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OTP ─────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ─── Safepay ─────────────────────────────────────
SAFEPAY_API_KEY=
SAFEPAY_SECRET=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_SANDBOX=true

# ─── Bunny Stream ────────────────────────────────
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=

# ─── Mux Live ────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ─── Email (Resend) ─────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@yourlms.com

# ─── SMS ─────────────────────────────────────────
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=LMS
